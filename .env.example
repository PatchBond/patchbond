# Copy to .env and fill in. Never commit .env.

# --- Network (deploy/<NEAR_NETWORK>.json holds contract, oracle, token, RPC) ---
NEAR_NETWORK=testnet
# Oracle key; if unset, read from ~/.near-credentials/<network>/<oracle>.json (near-cli legacy keychain)
# ORACLE_PRIVATE_KEY=ed25519:...

# --- AI judge ---
# nearai  = live judge: NEAR AI Cloud verifiable model in a TEE (needs NEARAI_API_KEY, ~$0.0004/verdict)
# offline = same pipeline, no API key: a local deterministic judge signing with a dev key (records say so)
JUDGE_MODE=offline
JUDGE_MODEL=z-ai/glm-5.3-flash
NEARAI_API_KEY=
# Fixed dev key so offline signatures keep one address across restarts: 0x + 64 hex chars
MOCK_SIGNER_KEY=

# --- GitHub App (open http://localhost:8787/setup to create it; it fills these in) ---
GITHUB_ORG=PatchBond
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY=
# Optional personal token for higher rate limits in judge-pr / eval / public judging
GITHUB_TOKEN=

# --- Server ---
PORT=8787
# Where GitHub sends webhooks: a public URL (for local dev, a tunnel such as smee.io or cloudflared)
PUBLIC_URL=http://localhost:8787
# Local dev: a smee.io channel (https://smee.io/new) forwarded with
#   bunx smee-client --url $WEBHOOK_URL --target http://localhost:8787/webhook
WEBHOOK_URL=
WEB_URL=http://localhost:5317
# Let anyone judge a public PR from the web app. Each live verdict costs credits, so it's capped:
# the same PR within 24 h reuses its verdict; JUDGE_DAILY_LIMIT per day overall, JUDGE_VISITOR_DAILY_LIMIT per visitor.
ALLOW_PUBLIC_JUDGE=1
JUDGE_DAILY_LIMIT=100
JUDGE_VISITOR_DAILY_LIMIT=10
CI_TIMEOUT_MIN=30
POLL_SEC=10
