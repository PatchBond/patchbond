# Copy to .env and fill in. Never commit .env.

# --- Network (deploy/<NEAR_NETWORK>.json holds contract, oracle, token, RPC) ---
NEAR_NETWORK=testnet
# Oracle key; if unset, read from ~/.near-credentials/<network>/<oracle>.json (near-cli legacy keychain)
# ORACLE_PRIVATE_KEY=ed25519:...

# --- AI judge ---
# mock   = deterministic stand-in judge signed by a dev key (every record is marked mock)
# nearai = NEAR AI Cloud verifiable model in a TEE (needs credits)
JUDGE_MODE=mock
JUDGE_MODEL=z-ai/glm-5.3-flash
NEARAI_API_KEY=
# Fixed dev key so mock signatures keep one address across restarts: 0x + 64 hex chars
MOCK_SIGNER_KEY=

# --- GitHub App (open http://localhost:8787/setup to create it; it fills these in) ---
GITHUB_ORG=PatchBond
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY=
# Optional personal token for higher rate limits in judge-pr / eval / public judging
GITHUB_TOKEN=

# --- Server ---
PORT=8787
# Where GitHub sends webhooks: a public URL (for local dev, a tunnel such as smee.io or cloudflared)
PUBLIC_URL=http://localhost:8787
# Local dev: a smee.io channel (https://smee.io/new) forwarded with
#   bunx smee-client --url $WEBHOOK_URL --target http://localhost:8787/webhook
WEBHOOK_URL=
WEB_URL=http://localhost:5317
# Let anyone judge a public PR from the web app (hosted demo)
ALLOW_PUBLIC_JUDGE=0
CI_TIMEOUT_MIN=30
POLL_SEC=10
